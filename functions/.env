# Non-secret Functions params, read by `firebase deploy` and the emulators.
# Deploys are non-interactive, so every defineString param needs a value here.
# Secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET) live in Secret Manager.
#
# Per-project overrides go in .env.<projectId>. The deploy workflow writes
# STRIPE_PRICE_ID there from the STRIPE_PRICE_ID repository variable.
APP_URL=https://solara-uv.web.app
STRIPE_PRICE_ID=
# The budget kill switch (src/ops/budget.ts, docs/RUNBOOK.md), in percent of the budget:
# a warning, the cost guard, and the hard stop that detaches billing. Detaching is on by
# default (default, owner may change): the deploy job writes COST_GUARD_DETACH_BILLING per
# project, false only when the repository variable of that name is false. BUDGET_ID and
# BUDGET_SERVICE_ACCOUNT (the budget's id and budgetAlert's own identity, both from
# infra/budget.sh) are written per project from the repository variables of the same name;
# empty accepts any budget and keeps the default identity.
COST_GUARD_WARN_PERCENT=50
COST_GUARD_THRESHOLD_PERCENT=100
COST_GUARD_DETACH_BILLING=true
COST_GUARD_DETACH_THRESHOLD_PERCENT=300
BUDGET_ID=
BUDGET_SERVICE_ACCOUNT=
# Billing (src/billing/config.ts): the yearly price and the switch that opens checkout.
# The deploy job writes both per project from the STRIPE_YEARLY_PRICE_ID and
# BILLING_ENABLED repository variables.
STRIPE_YEARLY_PRICE_ID=
BILLING_ENABLED=false
# The forecast proxy (src/forecast/): off until the owner switches it on with the
# FORECAST_PROXY_ENABLED repository variable; the OPEN_METEO_API_KEY secret holds the key.
FORECAST_PROXY_ENABLED=false
# Upstream calls the proxy and the calendar feed may make to the paid forecast API, per
# UTC hour and day, across instances (src/forecast/upstream-budget.ts). Defaults, owner may
# change: 20,000 a day is 60% of the Standard plan's 1 million calls a month.
FORECAST_UPSTREAM_PER_HOUR=1500
FORECAST_UPSTREAM_PER_DAY=20000
# Place search's own budget, apart from the forecasts' (REVIEW4 H1). Defaults, owner may
# change: 2,000 a day is 6% of the Standard plan.
PLACE_SEARCH_UPSTREAM_PER_HOUR=200
PLACE_SEARCH_UPSTREAM_PER_DAY=2000
# Linked calendars' place lookups have their own budget, apart from place search's
# (REVIEW5 M1). Defaults, owner may change.
EVENT_PLACE_LOOKUPS_PER_HOUR=50
EVENT_PLACE_LOOKUPS_PER_DAY=300
# Upstream calls one caller (an IPv4 address or IPv6 /64; a /48 gets 4 times as many) may
# cause per UTC hour in each budget (src/forecast/caller-share.ts). Default, owner may change.
UPSTREAM_SHARE_PER_CALLER=20
# Pro alerts (src/notifications/): off until the owner switches them on with the
# ALERTS_ENABLED repository variable. ALERTS_SERVICE_ACCOUNT is the identity the alerts
# job runs as (infra/alerts-identity.sh creates it); empty keeps the default identity.
# The deploy job writes both per project from the repository variables of the same name.
ALERTS_ENABLED=false
ALERTS_SERVICE_ACCOUNT=
# Linked calendars and Pro event heads-ups (src/events/, docs/integrations/EVENTS.md): off
# until the owner switches them on with the EVENTS_SUBSCRIPTIONS_ENABLED repository
# variable, which the deploy job writes per project. Heads-ups also need ALERTS_ENABLED.
EVENTS_SUBSCRIPTIONS_ENABLED=false
