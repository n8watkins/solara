{
  "name": "solara-functions",
  "description": "Solara Cloud Functions for billing, account data, notification registration, scheduled cleanup, and calendar feeds. Requires the Blaze plan.",
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "imports": {
    "#core": "./core/index.js"
  },
  "private": true,
  "scripts": {
    "build:core": "npm --prefix .. run build:core",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run build:core && npm run clean && tsc -p tsconfig.build.json",
    "gcp-build": "",
    "preserve": "npm run build",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "pretypecheck": "npm run build:core",
    "typecheck": "tsc -p .",
    "pretest": "npm run build",
    "test": "tsc -p . && node --test test/*.test.js",
    "pretest:rules": "npm run build",
    "test:rules": "cd .. && firebase emulators:exec --project demo-solara --only firestore \"node --test functions/test/emulator/*.test.js\"",
    "premigrate:feed-tokens": "npm run build",
    "migrate:feed-tokens": "node lib/feed/migrate-legacy-tokens.js"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.19.2",
    "firebase": "^13.1.0",
    "firebase-tools": "^15.34.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "allowScripts": {
    "@firebase/util": false,
    "protobufjs": false,
    "re2": false
  }
}
