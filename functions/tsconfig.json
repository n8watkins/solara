// Strict type checking of the Functions JavaScript via JSDoc (npm run typecheck, also run
// by npm test). Shared logic comes from @solara/core through the `#core` import, whose
// declarations are built into core/ by `npm run build:core`. The morning notifier
// (scripts/send-notifications.js and scripts/notification-core.js, moved from the repo
// root so firebase-admin leaves the web app) predates type checking; plan lane W3-B
// replaces it with a scheduled Function.
{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "scripts/**/*.js"
  ],
  "exclude": [
    "scripts/send-notifications.js",
    "scripts/notification-core.js"
  ]
}
