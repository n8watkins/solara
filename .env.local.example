NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Absolute site URL — used for OG/Twitter share image resolution
NEXT_PUBLIC_SITE_URL=https://uv-activity-planner.web.app

# Monetization (optional). Set to a Stripe Payment Link to enable Pro checkout.
# When unset, the Pro modal falls back to waitlist email capture.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
NEXT_PUBLIC_PRO_PRICE=$3.99/mo

# Google Calendar scheduling (optional). OAuth client ID from a Google Cloud
# project with the Calendar API enabled and your domain as an authorized JS origin.
# When unset, the "connect calendar" UI is hidden and recommendations run calendar-free.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
