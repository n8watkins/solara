# Copy to .env.local and fill in. Every NEXT_PUBLIC_* value is compiled into the
# public bundle, so none of them is a secret. Production takes these from GitHub
# repository variables instead (docs/DEPLOYMENT.md).

# Firebase web app config: firebase apps:sdkconfig web --project <project id>
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
# Web push (Firebase Project settings, Cloud Messaging, Web Push certificates).
# Required with NEXT_PUBLIC_ALERTS_ENABLED.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# App Check (reCAPTCHA v3 site key). Required whenever the Functions URL is set:
# every Function refuses requests without an App Check token.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
# 'recaptcha-enterprise' or 'recaptcha-v3' (the default); leave empty.
NEXT_PUBLIC_FIREBASE_APP_CHECK_PROVIDER=
# A debug token registered under App Check, Manage debug tokens, for local builds
# against a real project only. The deploy's env check refuses any deployed build
# that has one, because a token in a public bundle lets anyone pass App Check.
NEXT_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN=

# Absolute site URL - used for OG/Twitter share image resolution
NEXT_PUBLIC_SITE_URL=https://solara-uv.web.app
# Set only by the staging workflow (deploy-staging.yml): marks a staging build, which
# search engines are told not to index and the env check keeps free of production values.
# NEXT_PUBLIC_DEPLOY_ENVIRONMENT=staging

# Monetization and account services (optional). Set this to the deployed Cloud
# Functions origin to enable authenticated checkout, export, deletion, and feeds.
NEXT_PUBLIC_FUNCTIONS_URL=
# The switches below are '1' or empty, and each needs the Functions URL above.
# '1' replaces the Pro waitlist with Stripe Checkout.
NEXT_PUBLIC_BILLING_ENABLED=
# '1' sends forecasts through the forecast proxy Function (the commercial Open-Meteo key).
NEXT_PUBLIC_FORECAST_PROXY=
# '1' offers Pro morning and UV alerts in Settings (needs the VAPID key above).
NEXT_PUBLIC_ALERTS_ENABLED=
# '1' offers linked calendars in the Events section (and Pro event heads-ups).
NEXT_PUBLIC_EVENTS_SUBSCRIPTIONS_ENABLED=

# Google Calendar scheduling (optional). OAuth client ID from a Google Cloud
# project with the Calendar API enabled and your domain as an authorized JS origin.
# When unset, the "connect calendar" UI is hidden and recommendations run calendar-free.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
# '1' shows events already in Google Calendar (needs the client ID above).
NEXT_PUBLIC_GOOGLE_CALENDAR_EVENTS_ENABLED=

# Events from Outlook (optional, docs/integrations/OUTLOOK.md). The Application
# (client) ID of a dev app registration with the SPA redirect
# http://localhost/auth/microsoft/, and '1' to show the Outlook panel.
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
NEXT_PUBLIC_OUTLOOK_CALENDAR_EVENTS_ENABLED=

# Analytics (optional). Analytics remains off until the visitor opts in.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Error reporting (optional). A Sentry public DSN; when unset, no Sentry code ships.
NEXT_PUBLIC_SENTRY_DSN=
