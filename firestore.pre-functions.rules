rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isActiveAccount(userId) {
      let deletionPath = /databases/$(database)/documents/accountDeletionTombstones/$(userId);
      return !exists(deletionPath);
    }

    function serverBillingKeys() {
      return [
        'accountDeletionStartedAt',
        'proSince',
        'stripeCheckoutAttemptId',
        'stripeCheckoutReservedUntil',
        'stripeCheckoutSessionId',
        'stripeCheckoutStatus',
        'stripeCheckoutUpdatedAt',
        'stripeCustomerId',
        'stripeEventCreated',
        'stripeEventPriority',
        'stripeSubscriptionId',
        'subscriptionStatus',
        'subscriptionUpdatedAt'
      ];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) && isActiveAccount(userId);
      allow create: if isOwner(userId)
        && isActiveAccount(userId)
        && request.resource.data.tier != 'paid'
        && !request.resource.data.keys().hasAny(serverBillingKeys());
      allow update: if isOwner(userId)
        && isActiveAccount(userId)
        && (request.resource.data.tier == resource.data.tier
          || request.resource.data.tier != 'paid')
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverBillingKeys());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
