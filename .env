# Defaults for every build. Real values go in .env.local (see README.md).

# Firebase Local Emulator Suite, for the signed-in e2e suite only
# (npm run test:e2e:signed-in sets it to 1 for its own build). Declared empty here
# so every other build inlines it as "" and compiles the emulator code in
# lib/firebase.ts out; scripts/check-no-emulators.mjs fails `npm run build` if it
# is ever set.
NEXT_PUBLIC_FIREBASE_EMULATORS=

# Sentry error reporting (decision D10). Declared empty here so a build without a
# DSN inlines it as "", drops the SDK import in lib/error-reporting.ts and ships no
# Sentry code; .github/scripts/check-public-env.mjs --built verifies that.
NEXT_PUBLIC_SENTRY_DSN=
