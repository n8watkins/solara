{
  "displayName": "Solara: site or Functions down",
  "documentation": {
    "content": "An uptime check failed from more than one region for 10 minutes. Check https://solara-uv.web.app/app/ and the Functions in Cloud Run, then follow docs/RUNBOOK.md (Rollback).",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "Uptime check failing",
      "conditionThreshold": {
        "filter": "metric.type=\"monitoring.googleapis.com/uptime_check/check_passed\" AND resource.type=\"uptime_url\"",
        "aggregations": [
          {
            "alignmentPeriod": "600s",
            "perSeriesAligner": "ALIGN_NEXT_OLDER",
            "crossSeriesReducer": "REDUCE_COUNT_FALSE",
            "groupByFields": ["resource.label.host", "metric.label.check_id"]
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 1,
        "duration": "600s",
        "trigger": { "count": 1 }
      }
    }
  ],
  "alertStrategy": { "autoClose": "86400s" },
  "notificationChannels": ["CHANNEL"]
}
