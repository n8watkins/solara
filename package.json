{
  "name": "solara",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "postcss": "^8.5.10",
    "@grpc/grpc-js": "^1.14.6"
  },
  "scripts": {
    "predev": "node scripts/generate-sw.js",
    "dev": "next dev",
    "prebuild": "node scripts/generate-sw.js",
    "build": "next build",
    "postbuild": "node scripts/check-no-ui-harness.mjs && node scripts/check-no-emulators.mjs && node scripts/csp.mjs",
    "build:core": "node scripts/build-core.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 && npm run format:check",
    "check:docs": "node .github/scripts/check-docs.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "pretest": "npm run build --prefix functions",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:signed-in": "node tests/e2e/signed-in/run.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,mts,js,mjs,cjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,js,mjs,cjs,css}\"",
    "test:harness": "playwright test -c playwright.harness.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@solara/core": "*",
    "@tanstack/react-query": "^5.104.5",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "firebase": "^12.16.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/env": "^16.4.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.10",
    "prettier": "^3.9.10",
    "rolldown": "^1.2.15",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^24.16.0"
  },
  "allowScripts": {
    "@firebase/util": false,
    "protobufjs": false,
    "unrs-resolver": false
  }
}
