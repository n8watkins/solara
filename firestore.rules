rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function userCreateKeys() {
      return [
        'uid',
        'schemaVersion',
        'location',
        'savedLocations',
        'skinType',
        'profiles',
        'activeProfileId',
        'sunscreen',
        'activities',
        'tier',
        'calendarFeedToken',
        'onboardingComplete',
        'calendarHours',
        'showSunPath',
        'hiddenActivitySuggestionIds',
        'collapsedActivityCategories',
        'upgradeInterest',
        'notificationHour',
        'timezone'
      ];
    }

    function userUpdateKeys() {
      return [
        'schemaVersion',
        'location',
        'savedLocations',
        'skinType',
        'profiles',
        'activeProfileId',
        'sunscreen',
        'activities',
        'calendarFeedToken',
        'onboardingComplete',
        'calendarHours',
        'showSunPath',
        'hiddenActivitySuggestionIds',
        'collapsedActivityCategories',
        'upgradeInterest',
        'notificationHour',
        'timezone'
      ];
    }

    function validNewUser(userId) {
      return request.resource.data.keys().hasOnly(userCreateKeys())
        && request.resource.data.uid == userId
        && request.resource.data.tier in ['anonymous', 'free']
        && (!request.resource.data.keys().hasAny(['notificationHour'])
          || (request.resource.data.notificationHour is int
            && request.resource.data.notificationHour >= 0
            && request.resource.data.notificationHour <= 23));
    }

    function validUserUpdate(userId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(userUpdateKeys())
        && request.resource.data.uid == userId
        && request.resource.data.tier == resource.data.tier
        && (!request.resource.data.keys().hasAny(['notificationHour'])
          || (request.resource.data.notificationHour is int
            && request.resource.data.notificationHour >= 0
            && request.resource.data.notificationHour <= 23));
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && validNewUser(userId);
      allow update: if isOwner(userId) && validUserUpdate(userId);

      match /notificationDevices/{deviceId} {
        function clientDeviceKeys() {
          return ['token', 'enabled', 'platform', 'createdAt', 'updatedAt'];
        }

        function validDeviceFields() {
          return request.resource.data.token is string
            && request.resource.data.token.size() >= 20
            && request.resource.data.token.size() <= 4096
            && request.resource.data.enabled is bool
            && request.resource.data.platform in ['web', 'ios', 'android'];
        }

        function validNewDevice() {
          return request.resource.data.keys().hasOnly(clientDeviceKeys())
            && validDeviceFields();
        }

        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && validNewDevice();
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(clientDeviceKeys())
          && validDeviceFields();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
