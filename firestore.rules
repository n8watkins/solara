rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isActiveAccount(userId) {
      let deletionPath = /databases/$(database)/documents/accountDeletionTombstones/$(userId);
      return !exists(deletionPath)
        || (request.auth.token.auth_time is int
          && request.auth.token.auth_time > get(deletionPath).data.revokedBefore);
    }

    function userCreateKeys() {
      return [
        'uid',
        'schemaVersion',
        'location',
        'savedLocations',
        'skinType',
        'profiles',
        'activeProfileId',
        'sunscreen',
        'activities',
        'tier',
        'calendarFeedToken',
        'onboardingComplete',
        'calendarHours',
        'showSunPath',
        'hiddenActivitySuggestionIds',
        'collapsedActivityCategories',
        'upgradeInterest',
        'notificationHour',
        'timezone'
      ];
    }

    function userUpdateKeys() {
      return [
        'schemaVersion',
        'location',
        'savedLocations',
        'skinType',
        'profiles',
        'activeProfileId',
        'sunscreen',
        'activities',
        'calendarFeedToken',
        'onboardingComplete',
        'calendarHours',
        'showSunPath',
        'hiddenActivitySuggestionIds',
        'collapsedActivityCategories',
        'upgradeInterest',
        'notificationHour',
        'timezone'
      ];
    }

    function validNewUser(userId) {
      return request.resource.data.keys().hasOnly(userCreateKeys())
        && request.resource.data.uid == userId
        && request.resource.data.tier in ['anonymous', 'free']
        && (!request.resource.data.keys().hasAny(['notificationHour'])
          || (request.resource.data.notificationHour is int
            && request.resource.data.notificationHour >= 0
            && request.resource.data.notificationHour <= 23));
    }

    function validUserUpdate(userId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(userUpdateKeys())
        && request.resource.data.uid == userId
        && request.resource.data.tier == resource.data.tier
        && (!request.resource.data.keys().hasAny(['notificationHour'])
          || (request.resource.data.notificationHour is int
            && request.resource.data.notificationHour >= 0
            && request.resource.data.notificationHour <= 23));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) && isActiveAccount(userId);
      allow create: if isOwner(userId) && isActiveAccount(userId) && validNewUser(userId);
      allow update: if isOwner(userId) && isActiveAccount(userId) && validUserUpdate(userId);

      match /notificationDevices/{deviceId} {
        allow read: if isOwner(userId) && isActiveAccount(userId);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
