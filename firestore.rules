rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isActiveAccount(userId) {
      let deletionPath = /databases/$(database)/documents/accountDeletionTombstones/$(userId);
      return !exists(deletionPath);
    }

    function userCreateKeys() {
      return [
        'uid',
        'schemaVersion',
        'location',
        'savedLocations',
        'skinType',
        'profiles',
        'activeProfileId',
        'sunscreen',
        'activities',
        'tier',
        'calendarFeedToken',
        'onboardingComplete',
        'calendarHours',
        'showSunPath',
        'hiddenActivitySuggestionIds',
        'collapsedActivityCategories',
        'upgradeInterest',
        'notificationHour',
        'timezone'
      ];
    }

    function userUpdateKeys() {
      return [
        'schemaVersion',
        'location',
        'savedLocations',
        'skinType',
        'profiles',
        'activeProfileId',
        'sunscreen',
        'activities',
        'calendarFeedToken',
        'onboardingComplete',
        'calendarHours',
        'showSunPath',
        'hiddenActivitySuggestionIds',
        'collapsedActivityCategories',
        'upgradeInterest',
        'notificationHour',
        'timezone'
      ];
    }

    function validLocation(location) {
      return location is map
        && location.keys().hasAll(['lat', 'lon', 'city', 'region'])
        && location.keys().hasOnly(['lat', 'lon', 'city', 'region', 'timezone'])
        && location.lat is number
        && location.lat >= -90
        && location.lat <= 90
        && location.lon is number
        && location.lon >= -180
        && location.lon <= 180
        && location.city is string
        && location.region is string
        && (!location.keys().hasAny(['timezone']) || location.timezone is string);
    }

    function validSavedLocations(locations) {
      return locations is list
        && locations.size() <= 12
        && (locations.size() < 1 || validSavedLocation(locations[0]))
        && (locations.size() < 2 || validSavedLocation(locations[1]))
        && (locations.size() < 3 || validSavedLocation(locations[2]))
        && (locations.size() < 4 || validSavedLocation(locations[3]))
        && (locations.size() < 5 || validSavedLocation(locations[4]))
        && (locations.size() < 6 || validSavedLocation(locations[5]))
        && (locations.size() < 7 || validSavedLocation(locations[6]))
        && (locations.size() < 8 || validSavedLocation(locations[7]))
        && (locations.size() < 9 || validSavedLocation(locations[8]))
        && (locations.size() < 10 || validSavedLocation(locations[9]))
        && (locations.size() < 11 || validSavedLocation(locations[10]))
        && (locations.size() < 12 || validSavedLocation(locations[11]));
    }

    function validSavedLocation(location) {
      return location is map
        && location.lat is number
        && location.lat >= -90
        && location.lat <= 90
        && location.lon is number
        && location.lon >= -180
        && location.lon <= 180
        && location.city is string
        && location.region is string;
    }

    function validNewUser(userId) {
      return request.resource.data.keys().hasOnly(userCreateKeys())
        && request.resource.data.uid == userId
        && request.resource.data.tier in ['anonymous', 'free']
        && validLocation(request.resource.data.location)
        && (!request.resource.data.keys().hasAny(['savedLocations'])
          || validSavedLocations(request.resource.data.savedLocations))
        && (!request.resource.data.keys().hasAny(['notificationHour'])
          || (request.resource.data.notificationHour is int
            && request.resource.data.notificationHour >= 0
            && request.resource.data.notificationHour <= 23));
    }

    function validUserUpdate(userId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(userUpdateKeys())
        && request.resource.data.uid == userId
        && request.resource.data.tier == resource.data.tier
        && validLocation(request.resource.data.location)
        && (!request.resource.data.keys().hasAny(['savedLocations'])
          || validSavedLocations(request.resource.data.savedLocations))
        && (!request.resource.data.keys().hasAny(['notificationHour'])
          || (request.resource.data.notificationHour is int
            && request.resource.data.notificationHour >= 0
            && request.resource.data.notificationHour <= 23));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) && isActiveAccount(userId);
      allow create: if isOwner(userId) && isActiveAccount(userId) && validNewUser(userId);
      allow update: if isOwner(userId) && isActiveAccount(userId) && validUserUpdate(userId);

      match /notificationDevices/{deviceId} {
        allow read: if isOwner(userId) && isActiveAccount(userId);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
